# Address the browser and Kindle will use. Set your actual VPS IP.
KINDLEVEL_PUBLIC_URL=http://YOUR_VPS_IP

# Serve HTTP directly on port 80. Use 127.0.0.1 behind an existing reverse proxy.
KINDLEVEL_BIND_ADDRESS=0.0.0.0
KINDLEVEL_PORT=80

# Keep persistent data in this project folder.
KINDLEVEL_DATA_PATH=./data
TZ=UTC
